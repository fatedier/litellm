# TapTap local patch E2E environment variables
#
# Usage:
# 1. Copy this file to a local env file used by your shell / CI / test runner.
# 2. Fill in the required values for the scenarios you want to run.
# 3. Export them before running:
#      cd taptap/e2e
#      set -a; source .env.local; set +a
#      go run ./cmd/runner --list
#      go run ./cmd/runner --patch-id internal_spend_ingestion
#
# Notes:
# - The Go runner itself always needs TAPTAP_E2E_BASE_URL unless you only run --list.
# - All temporary users, teams, and keys are created and deleted through the proxy master key.
# - Each scenario declares its own requires_env list in cases/*.yaml.


############################
# Global
############################

# Base URL of the deployed LiteLLM test environment.
# Example: https://litellm-staging.example.com
TAPTAP_E2E_BASE_URL=


# Proxy master key used to:
# - create and delete temporary users
# - create and delete temporary teams
# - create and delete temporary keys
# - query spend logs for validation
TAPTAP_E2E_MASTER_KEY=


############################
# seedance_passthrough
############################

# Seedance passthrough endpoint path.
# Default: /volcengine/api/v3/contents/generations/tasks
TAPTAP_E2E_SEEDANCE_PATH=/volcengine/api/v3/contents/generations/tasks


############################
# Suggested test data contract
############################

# utc_daily_user_budget_guardrail
# - The environment should already be running with daily_user_budget_mode=enforce.
# - The master key must be allowed to create temporary users, teams, and keys.
# - The first warmup request for the created user should generate enough spend
#   to exceed the tiny configured daily cap before the second request.
#
# internal_spend_ingestion
# - The master key must be the literal configured proxy master key.
# - The master key must be allowed to create temporary keys and query spend logs.
#
# seedance_passthrough
# - The master key must be allowed to create temporary keys and query spend logs.
# - The test environment should have a working Seedance passthrough target.
